<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
		   fx:controller="com.javaninjas.careerpathway.pages.registration.controllers.SuccessfulRegistrationController"
		   alignment="CENTER" style="-fx-background-color: #e9e9e9; -fx-padding: 24;">


	<VBox alignment="CENTER" spacing="18" styleClass="card" style="-fx-padding: 40 20; -fx-pref-width: 320;">
		<Label fx:id="welcomeLabel" text="Welcome [Name]" style="-fx-font-size: 28px; -fx-font-weight: 700; -fx-text-fill: #111;" wrapText="true" textAlignment="CENTER" />

		<Label text="Your account was successfully made" style="-fx-text-fill: #444; -fx-font-size: 12px;" />

	<Button fx:id="quizButton" text="Take the quiz" onAction="#handleQuizButtonAction" prefWidth="220" prefHeight="40" styleClass="primary-btn" />

		<Label text="approx 5mins" style="-fx-text-fill: #666; -fx-font-size: 11px;" />

	</VBox>

</StackPane>

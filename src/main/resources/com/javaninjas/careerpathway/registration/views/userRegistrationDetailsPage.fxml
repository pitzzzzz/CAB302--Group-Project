<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx/17.0.12"
		   xmlns:fx="http://javafx.com/fxml/1"
		   fx:controller="com.javaninjas.careerpathway.registration.controllers.UserRegistrationController"
		   alignment="TOP_CENTER"
		   prefWidth="360"
		   prefHeight="640"
		   styleClass="root">

	<!-- top nav -->
	<fx:include source="../../core/views/topNavBack.fxml" />

	<!-- Page header -->
	<VBox alignment="CENTER" spacing="6" style="-fx-padding: 18 24 8 24;">
		<Label text="Create your account" styleClass="header" />
		<Label text="A few quick details and you’re ready to start" styleClass="subtitle" wrapText="true" maxWidth="320"/>
	</VBox>

	<!-- Main card -->
	<VBox alignment="TOP_CENTER" spacing="14" styleClass="card" prefWidth="320">
		<padding>
			<Insets top="18" right="18" bottom="18" left="18"/>
		</padding>

		<!-- Name row -->
		<HBox spacing="10" alignment="CENTER">
			<TextField fx:id="firstNameField" promptText="First name" styleClass="text-field" prefWidth="140"/>
			<TextField fx:id="lastNameField" promptText="Last name" styleClass="text-field" prefWidth="140"/>
		</HBox>

		<!-- Email -->
		<TextField fx:id="emailField" promptText="Email address" styleClass="text-field" prefWidth="280"/>

		<!-- Password -->
		<PasswordField fx:id="passwordField" promptText="Choose a password" styleClass="text-field" prefWidth="280"/>

		<!-- City -->
		<TextField fx:id="cityField" promptText="City" styleClass="text-field" prefWidth="280"/>

		<!-- Section header -->
		<Label text="A few more details to personalise your experience" wrapText="true" styleClass="section-header" maxWidth="280"/>

		<!-- Age & Stage -->
		<HBox spacing="12" alignment="CENTER">
			<ComboBox fx:id="ageSelect" promptText="Age" styleClass="combo-box" prefWidth="130"/>
			<ComboBox fx:id="profileStage" promptText="Stage" styleClass="combo-box" prefWidth="130"/>
		</HBox>

		<!-- Anonymous -->
		<HBox alignment="CENTER_LEFT" spacing="8" prefWidth="260">
			<CheckBox fx:id="anonymousCheck"/>
			<Label text="Keep my account anonymous" styleClass="label-muted"/>
		</HBox>

		<!-- Helper text -->
		<Label text="We’ll never share your personal info without consent." wrapText="true" styleClass="label-small" maxWidth="260"/>

		<!-- Register button -->
		<Button fx:id="registerButton"
				text="Create account"
				onAction="#onRegister"
				prefWidth="240"
				prefHeight="44"
				styleClass="primary-btn"/>

	</VBox>

</StackPane>

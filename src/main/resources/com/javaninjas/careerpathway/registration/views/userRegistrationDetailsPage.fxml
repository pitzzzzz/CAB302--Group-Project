<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
		   fx:controller="com.javaninjas.careerpathway.registration.controllers.UserRegistrationController"
		   alignment="TOP_CENTER" prefWidth="320" prefHeight="600" style="-fx-padding: 18;">

	<fx:include source="../../core/views/topNavBack.fxml" />

	<VBox alignment="TOP_CENTER" spacing="12" styleClass="card" style="-fx-padding: 18;">

		<!-- profile image placeholder -->
		<StackPane prefHeight="90" prefWidth="90">
			<Rectangle width="90" height="90" arcWidth="18" arcHeight="18" fill="WHITE" stroke="#cfcfcf" />
			<Label text="upload profile" style="-fx-font-size: 11px; -fx-text-fill: #444;" StackPane.alignment="BOTTOM_CENTER" />
		</StackPane>

		<!-- name fields side-by-side -->
		<HBox spacing="10" alignment="CENTER">
			<TextField fx:id="firstNameField" promptText="First name..." prefWidth="140" styleClass="text-field" />
			<TextField fx:id="lastNameField" promptText="Last name..." prefWidth="140" styleClass="text-field" />
		</HBox>

		<!-- email and city -->
	<TextField fx:id="emailField" promptText="Your email address..." prefWidth="300" styleClass="text-field" />
	<PasswordField fx:id="passwordField" promptText="Choose a password..." prefWidth="300" styleClass="password-field" />
	<TextField fx:id="cityField" promptText="Your city..." prefWidth="300" styleClass="text-field" />

		<!-- section header -->
		<Label text="Some more questions to personalise your experience" wrapText="true" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #222;" />

		<!-- two combo boxes side-by-side -->
		<HBox spacing="12" alignment="CENTER">
			<ComboBox fx:id="ageSelect" promptText="How old are you?" prefWidth="140" styleClass="text-field" />
				<ComboBox fx:id="profileStage" promptText="What stage are you?" prefWidth="140" styleClass="text-field" />
		</HBox>

		<!-- anonymous checkbox -->
		<HBox alignment="CENTER_LEFT" spacing="6">
			<Label text="keep my account 'anonymous'" />
			<CheckBox fx:id="anonymousCheck" />
		</HBox>

		<!-- register button centered -->
	<Button fx:id="registerButton" text="Register" onAction="#onRegister" prefWidth="220" prefHeight="40" styleClass="primary-btn" />

	</VBox>

</StackPane>

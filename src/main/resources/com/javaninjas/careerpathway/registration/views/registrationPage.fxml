<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaninjas.careerpathway.registration.controllers.RegistrationPageController"
      spacing="0" fillWidth="true" style="-fx-background-color: transparent;">
    <fx:include source="../../core/views/topNavBack.fxml" />

    <!-- Top banner: larger height to occupy more of the page -->
    <VBox alignment="TOP_CENTER" spacing="10" style="-fx-background-color: #e9e9e9; -fx-padding: 22 28 20 28;" minHeight="200" maxHeight="320" maxWidth="Infinity">
        <Label text="Explore Your\nPathways" alignment="CENTER" style="-fx-font-size: 34px; -fx-font-weight: 700; -fx-text-fill: #111;" />

        <HBox alignment="CENTER" spacing="28">
            <Circle radius="22" fill="WHITE" stroke="#cfcfcf" />
            <Circle radius="22" fill="WHITE" stroke="#cfcfcf" />
            <Circle radius="22" fill="WHITE" stroke="#cfcfcf" />
        </HBox>

        <HBox alignment="CENTER" spacing="36">
            <Label text="#benefit 1" style="-fx-font-size: 12px; -fx-text-fill: #333;" />
            <Label text="#benefit 2" style="-fx-font-size: 12px; -fx-text-fill: #333;" />
            <Label text="#benefit 3" style="-fx-font-size: 12px; -fx-text-fill: #333;" />
        </HBox>
    </VBox>

    <!-- Lower content: larger minimum height so the page feels fuller -->
    <VBox fx:id="lowerPanel" alignment="TOP_CENTER" spacing="18" style="-fx-background-color: white; -fx-padding: 26 28;" VBox.vgrow="ALWAYS" minHeight="420" maxWidth="Infinity">
        <Label text="some copy about the benefits of the application and some social proof" wrapText="true" style="-fx-text-fill: #333; -fx-font-size: 14px; -fx-alignment: center;" />

        <Button fx:id="createAccountButton" onAction="#handleCreateAccount" text="Create Account" prefWidth="260" prefHeight="48" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 24; -fx-font-size: 15px; -fx-font-weight: 700;" />

        <!-- Spacer pushes content up and ensures the lower area still occupies the page -->
        <Region VBox.vgrow="ALWAYS" />
    </VBox>

</VBox>

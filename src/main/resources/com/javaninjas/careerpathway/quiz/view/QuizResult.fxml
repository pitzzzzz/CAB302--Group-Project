<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<VBox xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaninjas.careerpathway.pages.quiz.QuizResultController"
      alignment="TOP_CENTER"
      spacing="12"
      prefWidth="480"
      prefHeight="640"
      styleClass="root">


    <!-- Header -->
    <StackPane prefHeight="360" minHeight="280">
        <Rectangle width="480" height="360" arcWidth="16" arcHeight="16" fill="#e6e6e6" stroke="#c7cbd0"/>

        <VBox alignment="TOP_CENTER" spacing="8" translateY="36">
            <Label text="You're All Set!" styleClass="header"/>
            <Label text="here's what we've learned so far..." styleClass="subtitle"/>
        </VBox>

        <Ellipse radiusX="300" radiusY="80" fill="white" strokeWidth="0" StackPane.alignment="BOTTOM_CENTER" translateY="44"/>
    </StackPane>

    <!-- Learned items card -->
    <ScrollPane fitToWidth="true" prefWidth="440" prefHeight="180" style="-fx-background-color:transparent;">
        <VBox fx:id="detailsBox" spacing="18" alignment="TOP_LEFT" styleClass="card">
            <!-- Example items dynamically populated by controller -->
        </VBox>
    </ScrollPane>

    <Region VBox.vgrow="ALWAYS"/>

    <!-- Bottom CTA -->
    <StackPane prefHeight="120" alignment="CENTER">
        <Button fx:id="dashboardButton" text="Go To Dashboard" prefWidth="260" prefHeight="44"
                styleClass="primary-btn"
                onAction="#goToDashboard"/>

    </StackPane>
</VBox>

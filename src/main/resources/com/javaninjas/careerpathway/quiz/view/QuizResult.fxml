<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.shape.*?>

<!-- Result screen styled like onboarding: gray header, concave white footer and list of learned items -->
<VBox xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      alignment="TOP_CENTER"
      spacing="12"
      prefWidth="480"
      prefHeight="640"
      style="-fx-background-color: white;">

    <fx:include source="../../core/views/topNavBack.fxml" />

    <!-- Large gray header with rounded corners -->
    <StackPane prefHeight="360" minHeight="280">
        <Rectangle width="480" height="360" arcWidth="16" arcHeight="16" fill="#e6e6e6" stroke="#c7cbd0" />

        <!-- Title area inside gray header -->
        <VBox alignment="TOP_CENTER" spacing="8" translateY="36">
            <Label text="You're All Set!" style="-fx-font-size:26px; -fx-font-weight:bold; -fx-text-fill:#111827;" />
            <Label text="here's what we've learned so far..." style="-fx-font-size:12px; -fx-text-fill:#374151;" />
        </VBox>

        <!-- White ellipse at bottom to create concave curve and reveal white footer -->
        <Ellipse radiusX="300" radiusY="80" fill="white" strokeWidth="0" StackPane.alignment="BOTTOM_CENTER" translateY="44" />
    </StackPane>

    <!-- Content list that visually sits over the lower part of the gray header and the white area -->
    <ScrollPane fitToWidth="true" prefWidth="440" prefHeight="180" style="-fx-background-color:transparent; -fx-background:transparent;">
        <VBox fx:id="detailsBox" spacing="18" alignment="TOP_LEFT">
            <padding>
                <Insets top="8" right="8" bottom="8" left="8" />
            </padding>
            <!-- Example item rows; these should be populated by controller in real use -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Circle radius="18" fill="white" stroke="#9ca3af" />
                <VBox spacing="4">
                    <Label text="#learning 1" style="-fx-font-weight:bold; -fx-text-fill:#111827;" />
                    <Label text="some copy explaining the learning..." wrapText="true" style="-fx-text-fill:#6b7280; -fx-font-size:12px;" />
                </VBox>
            </HBox>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <Circle radius="18" fill="white" stroke="#9ca3af" />
                <VBox spacing="4">
                    <Label text="#learning 2" style="-fx-font-weight:bold; -fx-text-fill:#111827;" />
                    <Label text="some copy explaining the learning..." wrapText="true" style="-fx-text-fill:#6b7280; -fx-font-size:12px;" />
                </VBox>
            </HBox>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <Circle radius="18" fill="white" stroke="#9ca3af" />
                <VBox spacing="4">
                    <Label text="#learning 3" style="-fx-font-weight:bold; -fx-text-fill:#111827;" />
                    <Label text="some copy explaining the learning..." wrapText="true" style="-fx-text-fill:#6b7280; -fx-font-size:12px;" />
                </VBox>
            </HBox>
        </VBox>
    </ScrollPane>

    <Region VBox.vgrow="ALWAYS" />

    <!-- Bottom curved white footer overlapping the gray header; contains the primary CTA -->
    <StackPane prefHeight="120" prefWidth="480" alignment="CENTER">
        <Rectangle width="460" height="120" arcWidth="40" arcHeight="40" fill="white" stroke="#e5e7eb" />
        <Button fx:id="dashboardButton" text="Go To Dashboard" prefWidth="260" prefHeight="44" style="-fx-background-color:#3b82f6; -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:22;" />
    </StackPane>

</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<VBox xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaninjas.careerpathway.pages.quiz.controller.QuizQuestionController"
      alignment="TOP_CENTER"
      spacing="0"
      prefWidth="480"
      prefHeight="640"
      styleClass="root">

    <!-- Scrollable content -->
    <ScrollPane fitToWidth="true" vbarPolicy="AS_NEEDED" hbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
        <content>
            <VBox alignment="TOP_CENTER" spacing="16" style="-fx-background-color: transparent;">

                <!-- Header -->
                <StackPane prefHeight="210" minHeight="140" maxHeight="260">
                    <Pane prefHeight="210" style="-fx-background-color:#e6e6e6; -fx-background-radius:0 0 40 40;" />
                    <!-- Dynamic progress dots container (controller will populate) -->
                    <HBox fx:id="progressDots" spacing="10" alignment="TOP_CENTER" translateY="18" StackPane.alignment="TOP_CENTER"/>
                    <Ellipse radiusX="300" radiusY="80" fill="white" strokeWidth="0"
                             StackPane.alignment="BOTTOM_CENTER" translateY="44"/>
                </StackPane>

                <!-- Quiz content card -->
                <VBox alignment="TOP_CENTER" spacing="12" prefWidth="420" styleClass="card">
                    <Label fx:id="titleLabel" text="Your Interests" styleClass="header"/>

                    <!-- Questions 1–5 -->
                    <VBox spacing="6" prefWidth="420">
                        <Label fx:id="q1Label" text="Question 1" styleClass="section-header" wrapText="true" maxWidth="420"/>
                        <VBox fx:id="q1Options" spacing="8" alignment="TOP_LEFT" prefWidth="400"/>
                    </VBox>

                    <VBox spacing="6" prefWidth="420">
                        <Label fx:id="q2Label" text="Question 2" styleClass="section-header" wrapText="true" maxWidth="420"/>
                        <VBox fx:id="q2Options" spacing="8" alignment="TOP_LEFT" prefWidth="400"/>
                    </VBox>

                    <VBox spacing="6" prefWidth="420">
                        <Label fx:id="q3Label" text="Question 3" styleClass="section-header" wrapText="true" maxWidth="420"/>
                        <VBox fx:id="q3Options" spacing="8" alignment="TOP_LEFT" prefWidth="400"/>
                    </VBox>

                    <VBox spacing="6" prefWidth="420">
                        <Label fx:id="q4Label" text="Question 4" styleClass="section-header" wrapText="true" maxWidth="420"/>
                        <VBox fx:id="q4Options" spacing="8" alignment="TOP_LEFT" prefWidth="400"/>
                    </VBox>

                    <VBox spacing="6" prefWidth="420">
                        <Label fx:id="q5Label" text="Question 5" styleClass="section-header" wrapText="true" maxWidth="420"/>
                        <VBox fx:id="q5Options" spacing="8" alignment="TOP_LEFT" prefWidth="400"/>
                    </VBox>

                    <Label fx:id="feedbackLabel" text="" styleClass="feedback"/>
                </VBox>
            </VBox>
        </content>
    </ScrollPane>

    <!-- Bottom controls -->
    <VBox alignment="CENTER" spacing="6" prefWidth="420" style="-fx-padding:12;">
        <Button fx:id="continueButton" text="Continue" maxWidth="Infinity" prefHeight="44" styleClass="primary-btn"/>
        <Button fx:id="previousButton" onAction="#onPrevious" text="Go to previous question" maxWidth="Infinity" prefHeight="30" styleClass="secondary-btn"/>
    </VBox>
</VBox>

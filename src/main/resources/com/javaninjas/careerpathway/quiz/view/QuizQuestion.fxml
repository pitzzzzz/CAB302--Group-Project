<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.shape.*?>

<VBox xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaninjas.careerpathway.quiz.QuizQuestionController"
      alignment="TOP_CENTER"
      spacing="0"
      prefWidth="480"
      prefHeight="640"
      style="-fx-background-color: white;">

    <ScrollPane fitToWidth="true" vbarPolicy="AS_NEEDED" hbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
        <content>
            <VBox alignment="TOP_CENTER" spacing="16" style="-fx-background-color: white;">

                <!-- Header -->
                <StackPane prefHeight="210" minHeight="140" maxHeight="260">
                    <Pane prefHeight="210" style="-fx-background-color:#e6e6e6;" />
                    <HBox spacing="10" alignment="TOP_CENTER" translateY="18">
                        <Circle radius="6" fill="#374151"/>
                        <Circle radius="6" fill="#374151"/>
                        <Circle radius="6" fill="#374151"/>
                        <Circle radius="6" fill="#374151"/>
                        <Circle radius="5" fill="#9ca3af"/>
                        <Circle radius="5" fill="#d1d5db"/>
                    </HBox>
                    <Ellipse radiusX="300" radiusY="80" fill="white" strokeWidth="0"
                             StackPane.alignment="BOTTOM_CENTER" translateY="44"/>
                </StackPane>

                <!-- Content area: show a set of 5 questions at once -->
                <VBox alignment="TOP_CENTER" spacing="12" prefWidth="420">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <Label fx:id="titleLabel" text="Your Interests" style="-fx-font-size:22px; -fx-font-weight:bold;"/>

                    <!-- Question 1 -->
                    <VBox spacing="6" prefWidth="420">
                        <Label fx:id="q1Label" text="Question 1" style="-fx-font-size:14px; -fx-font-weight:600; -fx-text-fill:#111827;" wrapText="true" maxWidth="420" alignment="TOP_LEFT" />
                        <VBox fx:id="q1Options" spacing="8" alignment="TOP_LEFT" prefWidth="400" />
                    </VBox>

                    <!-- Question 2 -->
                    <VBox spacing="6" prefWidth="420">
                        <Label fx:id="q2Label" text="Question 2" style="-fx-font-size:14px; -fx-font-weight:600; -fx-text-fill:#111827;" wrapText="true" maxWidth="420" alignment="TOP_LEFT"/>
                        <VBox fx:id="q2Options" spacing="8" alignment="TOP_LEFT" prefWidth="400" />
                    </VBox>

                    <!-- Question 3 -->
                    <VBox spacing="6" prefWidth="420">
                        <Label fx:id="q3Label" text="Question 3" style="-fx-font-size:14px; -fx-font-weight:600; -fx-text-fill:#111827;" wrapText="true" maxWidth="420" alignment="TOP_LEFT"/>
                        <VBox fx:id="q3Options" spacing="8" alignment="TOP_LEFT" prefWidth="400" />
                    </VBox>

                    <!-- Question 4 -->
                    <VBox spacing="6" prefWidth="420">
                        <Label fx:id="q4Label" text="Question 4" style="-fx-font-size:14px; -fx-font-weight:600; -fx-text-fill:#111827;" wrapText="true" maxWidth="420" alignment="TOP_LEFT"/>
                        <VBox fx:id="q4Options" spacing="8" alignment="TOP_LEFT" prefWidth="400" />
                    </VBox>

                    <!-- Question 5 -->
                    <VBox spacing="6" prefWidth="420">
                        <Label fx:id="q5Label" text="Question 5" style="-fx-font-size:14px; -fx-font-weight:600; -fx-text-fill:#111827;" wrapText="true" maxWidth="420" alignment="TOP_LEFT"/>
                        <VBox fx:id="q5Options" spacing="8" alignment="TOP_LEFT" prefWidth="400" />
                    </VBox>

                    <Label fx:id="feedbackLabel" text="" style="-fx-text-fill:#b00020; -fx-font-size:12px;"/>
                </VBox>

            </VBox>
        </content>
    </ScrollPane>

    <!-- Bottom controls -->
    <VBox alignment="CENTER" spacing="6" prefWidth="420" style="-fx-padding:12;">
        <Button fx:id="continueButton" text="Continue" maxWidth="Infinity" prefHeight="44"
                style="-fx-background-color:#3b82f6; -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:22;"/>
        <Label text="go to previous question" style="-fx-font-size:11px; -fx-text-fill:#374151;"/>
    </VBox>

</VBox>

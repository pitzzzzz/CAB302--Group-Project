<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<StackPane fx:id="rootPane" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javaninjas.careerpathway.login.controllers.LoginPageController"
                     alignment="CENTER" style="-fx-background-color: linear-gradient(to bottom right, #f4f6f8, #eef7ff);">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24" />
    </padding>

        <!-- animated background rectangle (behind content) -->
        <Rectangle fx:id="bgRect" fill="#f4f6f8" />

        <!-- Outer card (container) -->
        <VBox alignment="CENTER" spacing="0" maxWidth="760" prefWidth="760">
                <VBox fx:id="card" alignment="CENTER" spacing="0" maxWidth="720.0" prefWidth="720.0"
                            style="-fx-background-color: transparent; -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: transparent; -fx-border-width: 0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12,0,0,6);">
            <padding>
                <Insets bottom="0" left="0" right="0" top="0" />
            </padding>

            <!-- Inner white panel (foreground) -->
                        <VBox alignment="CENTER" spacing="12" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 28; -fx-max-width: 480;">

                <!-- Logo / header -->
                <Label fx:id="welcomeText" text="[ INSERT LOGO ]" alignment="CENTER"
                       style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #444444; -fx-padding: 6 0 10 0;" />

                <VBox alignment="CENTER" spacing="10" maxWidth="320">
                    <!-- Username / Email field -->
                    <TextField fx:id="emailField" promptText="Username"
                               prefHeight="36" prefWidth="300"
                               style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #d6d6d6; -fx-padding: 0 10 0 10; -fx-font-size: 13px;" />

                    <!-- Password field -->
                    <PasswordField fx:id="passwordField" promptText="Password"
                                   prefHeight="36" prefWidth="300"
                                   style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #d6d6d6; -fx-padding: 0 10 0 10; -fx-font-size: 13px;" />

                    <!-- Message label (small, neutral) -->
                    <Label fx:id="messageLabel"
                           style="-fx-text-fill: #b00000; -fx-font-size: 12px;" />

                    <!-- Login button (blue, rounded, prominent) -->
            <Button fx:id="submitButton" defaultButton="true" onAction="#handleLogin" text="Login"
                prefWidth="260" prefHeight="40"
                style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: 600; -fx-background-radius: 20; -fx-border-radius: 20; -fx-cursor: hand;">
                        <VBox.margin>
                            <Insets top="12" bottom="6" />
                        </VBox.margin>
                    </Button>

                    <!-- Signup text stacked beneath the prompt -->
                    <VBox alignment="CENTER" spacing="4">
                        <Label text="don't have an account?" style="-fx-font-size: 11px; -fx-text-fill: #6b6b6b; -fx-font-style: italic;" />
                        <Hyperlink onAction="#handleRegisterLink" text="sign up here" style="-fx-font-size: 11px; -fx-text-fill: #3b82f6; -fx-font-style: italic; -fx-underline: true;" />
                    </VBox>

                </VBox>

            </VBox>

        </VBox>

    </VBox>

</StackPane>

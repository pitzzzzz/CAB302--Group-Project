<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootPane" alignment="CENTER" style="-fx-background-color: linear-gradient(to bottom right, #f4f6f8, #eef7ff);" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javaninjas.careerpathway.login.controllers.LoginPageController">

    <padding>
        <Insets bottom="24" left="24" right="24" top="24" />
    </padding>

    <!-- Top-left back button include -->
    <fx:include source="../../core/views/topNavBack.fxml" />

    <!-- Main login card -->
    <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="500.0" spacing="12" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 28;" styleClass="card">

        <!-- Logo / header -->
        <Label fx:id="welcomeText" alignment="CENTER" style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #444444; -fx-padding: 6 0 10 0;" text="[ INSERT LOGO ]" />

        <!-- Login form -->
        <VBox alignment="CENTER" maxWidth="320" spacing="10">

            <!-- Email field -->
            <TextField fx:id="emailField" prefHeight="36" prefWidth="300" promptText="Email" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #d6d6d6; -fx-padding: 0 10 0 10; -fx-font-size: 13px;" />

            <!-- Password field -->
            <PasswordField fx:id="passwordField" prefHeight="36" prefWidth="300" promptText="Password" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #d6d6d6; -fx-padding: 0 10 0 10; -fx-font-size: 13px;" />

            <!-- Message label -->
            <Label fx:id="messageLabel" style="-fx-text-fill: #b00000; -fx-font-size: 12px;" />

            <!-- Login button -->
            <Button fx:id="submitButton" defaultButton="true" onAction="#handleLogin" prefHeight="40" prefWidth="260" styleClass="primary-btn" text="Login">
                <VBox.margin>
                    <Insets bottom="6" top="12" />
                </VBox.margin>
            </Button>

            <!-- Signup section -->
            <VBox alignment="CENTER" spacing="4">
                <Label style="-fx-font-size: 11px; -fx-text-fill: #6b6b6b; -fx-font-style: italic;" text="don't have an account?" />
                <Hyperlink onAction="#handleRegisterLink" style="-fx-font-size: 11px; -fx-text-fill: #3b82f6; -fx-font-style: italic; -fx-underline: true;" text="sign up here" />
            </VBox>

        </VBox>

    </VBox>

</StackPane>

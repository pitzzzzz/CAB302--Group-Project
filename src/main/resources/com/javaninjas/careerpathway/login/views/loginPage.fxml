<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javaninjas.careerpathway.login.controllers.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label fx:id="welcomeText" />
    <Button onAction="#onHelloButtonClick" text="Hello!" />



    <GridPane alignment="CENTER" hgap="10" vgap="10">

        <padding>
            <Insets bottom="20" left="20" right="20" top="20" />
        </padding>

        <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="emailField" promptText="Enter your email" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Password:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <PasswordField fx:id="passwordField" promptText="Enter your password" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Button fx:id="submitButton" defaultButton="true" onAction="#handleLogin" prefHeight="20" prefWidth="100" text="Login" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.halignment="CENTER" GridPane.rowIndex="3" GridPane.rowSpan="1">
            <GridPane.margin>
                <Insets bottom="20" left="0" right="0" top="20" />
            </GridPane.margin>
        </Button>

        <HBox alignment="CENTER_LEFT" spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="4">
            <Label text="Don't have an account?" />
            <Hyperlink onAction="#handleRegisterLink" text="Click here" />
        </HBox>

        <Label fx:id="messageLabel" GridPane.columnIndex="1" GridPane.rowIndex="2" />

    </GridPane>

</VBox>

<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaninjas.careerpathway.pages.components.PathwayCardController"
      fx:id="cardRoot"
      spacing="12" alignment="TOP_LEFT"
      style="-fx-border-color:#e1e5e9; -fx-border-radius:16; -fx-background-radius:16; -fx-padding:20; -fx-background-color:white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08),12,0,0,4);"
      prefWidth="280" prefHeight="200" maxWidth="320">

    <!-- Job Title -->
    <Label fx:id="jobTitle" text="Software Engineer"
           style="-fx-font-weight:bold; -fx-font-size:18; -fx-text-fill:#1a202c;"
           wrapText="true" />

    <!-- Job Description -->
    <Label fx:id="jobDescription" text="Design and develop software applications..."
           wrapText="true"
           style="-fx-text-fill:#4a5568; -fx-font-size:13; -fx-line-spacing:2;"
           maxHeight="60" />

    <!-- Salary Badge -->
    <HBox alignment="CENTER_LEFT">
        <Label fx:id="pathwaySalaryLabel" text="Avg salary - $x.xxx" style="-fx-font-size:13;" />
    </HBox>

    <!-- Spacer to push button to bottom -->
    <Region VBox.vgrow="ALWAYS" />

       <HBox alignment="CENTER_LEFT" spacing="12">
              <CheckBox fx:id="compareToggle" text="Compare" style="-fx-font-size:12; -fx-font-weight:600;" />

              <!-- Learn More Button expands to take available space -->
              <Button fx:id="learnMoreBtn" text="Learn More" HBox.hgrow="ALWAYS"
                            prefHeight="36"
                            style="-fx-background-color:#3b82f6; -fx-text-fill:white; -fx-background-radius:18; -fx-padding:8 20; -fx-font-weight:600; -fx-font-size:13;" />

              <!-- Favourite heart toggle (styled to appear as a heart at bottom-right) -->
              <ToggleButton fx:id="favouriteBtn" mnemonicParsing="false" prefWidth="40" prefHeight="36" style="-fx-background-color: transparent; -fx-padding:0; -fx-cursor: hand;">
                     <graphic>
                            <Label text="♡" fx:id="heartLabel" style="-fx-font-size:20; -fx-text-fill: #cbd5e1; -fx-padding:0 6 0 6;" />
                     </graphic>
              </ToggleButton>
       </HBox>

</VBox>
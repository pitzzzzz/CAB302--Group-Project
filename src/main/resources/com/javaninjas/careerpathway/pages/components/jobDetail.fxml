<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Pos?>

<StackPane xmlns="http://javafx.com/javafx/11.0.1"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.javaninjas.careerpathway.pages.components.JobDetailController"
           fx:id="root"
           alignment="CENTER"
           maxWidth="Infinity"
           maxHeight="Infinity"
           style="-fx-background-color: rgba(0,0,0,0.55);">

    <!-- Popup Card Centered -->
    <VBox fx:id="card" spacing="12" alignment="TOP_LEFT" StackPane.alignment="CENTER"
          maxWidth="640"
          style="-fx-background-color: white; -fx-border-radius:12; -fx-background-radius:12; -fx-padding:18;
                 -fx-effect: dropshadow(one-pass-box, rgba(0,0,0,0.18),18,0,0,6);">
        <children>
            <HBox alignment="CENTER_RIGHT">
                <children>
                    <Label fx:id="titleLabel" text="Job Title"
                           style="-fx-font-size:20; -fx-font-weight:bold;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="closeBtn" text="Go Back"
                            style="-fx-background-radius:14; -fx-background-color:#e3e3e3;" />
                </children>
            </HBox>

            <Label fx:id="descLabel" wrapText="true"
                   text="Job description goes here"
                   style="-fx-text-fill:#444; -fx-font-size:13;" />

            <Label fx:id="salaryLabel" text="Avg salary - $x.xxx"
                   style="-fx-font-size:13; -fx-font-weight:bold;" />

            <HBox spacing="8">
                <children>
                    <Label text="benefit #1"
                           style="-fx-border-color:#ddd; -fx-padding:8;
                                  -fx-background-radius:8; -fx-border-radius:8;" />
                    <Label text="benefit #2"
                           style="-fx-border-color:#ddd; -fx-padding:8;
                                  -fx-background-radius:8; -fx-border-radius:8;" />
                    <Label text="benefit #3"
                           style="-fx-border-color:#ddd; -fx-padding:8;
                                  -fx-background-radius:8; -fx-border-radius:8;" />
                </children>
            </HBox>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <children>
                    <Label text="Have you heard of this career before?" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="selectBtn" text="Select This Career"
                            style="-fx-background-color:#4c89d9; -fx-text-fill:white;
                                   -fx-background-radius:14; -fx-padding:8 16;" />
                </children>
            </HBox>
        </children>
    </VBox>
</StackPane>

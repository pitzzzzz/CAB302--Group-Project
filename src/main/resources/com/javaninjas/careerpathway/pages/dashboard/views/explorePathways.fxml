<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
			fx:controller="com.javaninjas.careerpathway.pages.dashboard.controllers.ExploreController"
			prefWidth="1200" prefHeight="800">

	<!-- Top section -->
	<top>
		<AnchorPane style="-fx-background-color: transparent; -fx-padding: 16;">
			<Label text="The possibilities are endless..." AnchorPane.leftAnchor="16" AnchorPane.topAnchor="8">
				<font>
					<Font name="System Bold" size="20"/>
				</font>
			</Label>

			<Button fx:id="logoutBtn" text="Logout" onAction="#handleLogout"
					AnchorPane.rightAnchor="16" AnchorPane.topAnchor="8"
					style="-fx-background-radius:16; -fx-border-radius:16; -fx-padding:6 12;" />

			<HBox alignment="CENTER" AnchorPane.topAnchor="50" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" style="-fx-padding: 5;">
				<Button style="-fx-background-color: #6699cc; -fx-text-fill: white; -fx-background-radius: 15; -fx-padding: 12 28; -fx-font-size: 16;"
						text="Find Out More"
				onAction="#handleExplore"/>
			</HBox>
		</AnchorPane>
	</top>

	<!-- Center section: job list -->
	<center>
		<VBox spacing="50">
			<padding>
				<Insets top="20" right="20" bottom="20" left="20"/>
			</padding>
			<ListView fx:id="jobListView" prefHeight="600" prefWidth="600"/>
		</VBox>
	</center>

	<!-- Bottom navigation -->
	<bottom>
		<fx:include source="/com/javaninjas/careerpathway/core/views/bottomNav.fxml" />
	</bottom>

</BorderPane>


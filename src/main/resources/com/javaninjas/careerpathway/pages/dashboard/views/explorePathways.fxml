<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javaninjas.careerpathway.pages.dashboard.controllers.ExploreController" fx:id="rootPane">
    
    <BorderPane fx:id="mainContent">

    <!-- Top section -->
    <top>
        <AnchorPane style="-fx-background-color: transparent; -fx-padding: 16;">
            <Label text="The possibilities are endless..." AnchorPane.leftAnchor="16" AnchorPane.topAnchor="8">
                <font>
                    <Font name="System Bold" size="20" />
                </font>
            </Label>

            <Button fx:id="logoutBtn" onAction="#handleLogout" style="-fx-background-radius:16; -fx-border-radius:16; -fx-padding:6 12;" text="Logout" AnchorPane.rightAnchor="16" AnchorPane.topAnchor="8" />

            <VBox alignment="CENTER" spacing="12" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="50">
                <Label style="-fx-font-size: 14; -fx-text-fill: #666666;" text="Explore different career pathways and find the one that's right for you" />

                <HBox alignment="CENTER" spacing="16">
                    <Label text="Select two degrees to compare" style="-fx-font-size: 14; -fx-font-weight: 600; -fx-text-fill: #1f2933;" />
                    <HBox alignment="CENTER" spacing="6">
                        <Label fx:id="compareSlotOneLabel" text="First degree" style="-fx-background-color:#e2e8f0; -fx-padding:6 12; -fx-background-radius:14; -fx-font-size:12; -fx-text-fill:#1f2933;" />
                        <Label text="vs" style="-fx-font-size:12; -fx-text-fill:#475569;" />
                        <Label fx:id="compareSlotTwoLabel" text="Second degree" style="-fx-background-color:#e2e8f0; -fx-padding:6 12; -fx-background-radius:14; -fx-font-size:12; -fx-text-fill:#1f2933;" />
                    </HBox>
                    <Button fx:id="compareButton" text="Compare" disable="true" onAction="#handleCompare" style="-fx-background-color:#3b82f6; -fx-text-fill:white; -fx-background-radius:16; -fx-padding:8 20; -fx-font-weight:600; -fx-font-size:13;" />
                    <Button fx:id="clearCompareButton" text="Clear" disable="true" onAction="#handleClearCompare" style="-fx-background-color:transparent; -fx-border-color:#cbd5e1; -fx-border-radius:16; -fx-padding:8 20; -fx-font-size:13; -fx-text-fill:#475569;" />
                </HBox>

                <Label fx:id="compareHintLabel" text="Select any two cards below to activate comparison." style="-fx-font-size:12; -fx-text-fill:#64748b;" />

                <!-- Filter component included here -->
                <fx:include fx:id="filterComponent" source="/com/javaninjas/careerpathway/pages/dashboard/components/pathwayFilter.fxml" />
            </VBox>


        </AnchorPane>
    </top>

    <!-- Center section: job cards grid -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #f8f9fa;">
            <VBox spacing="20">
                <padding>
                    <Insets bottom="20" left="20" right="20" top="20" />
                </padding>

                <!-- Cards container with responsive grid -->
                <FlowPane fx:id="pathwayCardsContainer" alignment="CENTER" hgap="20" prefWrapLength="1000" style="-fx-padding: 10;" vgap="20" />

            </VBox>
        </ScrollPane>
    </center>

        <!-- Bottom navigation -->
        <bottom>
            <fx:include source="/com/javaninjas/careerpathway/core/views/bottomNav.fxml" />
        </bottom>

    </BorderPane>
    
    <!-- Blur overlay for popup background -->
    <Pane fx:id="blurPane" style="-fx-background-color: rgba(0, 0, 0, 0.3);" visible="false" />
    
</StackPane>

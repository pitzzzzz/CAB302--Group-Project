<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javaninjas.careerpathway.pages.dashboard.controllers.PathwayController" fx:id="rootPane">
	<!-- Top header -->
	<top>
		<AnchorPane style="-fx-padding:16;">
			<Button fx:id="logoutBtn" text="Logout" AnchorPane.rightAnchor="12" AnchorPane.topAnchor="8" style="-fx-background-radius:16; -fx-padding:6 12;" onAction="#handleLogout" />
		</AnchorPane>
	</top>

	<!-- Center content: recommended jobs / pathway dashboard -->
	<center>
		<VBox spacing="12" style="-fx-padding:18; -fx-alignment:CENTER;">
			<Label fx:id="welcomeLabel" text="Welcome [name]," style="-fx-font-size:28; -fx-font-weight:bold;" />
			<Label text="here are the top careers we would recommend..." style="-fx-font-size:14; -fx-text-fill:#333;" />

			<!-- Row of 5 job cards -->
			<HBox spacing="12" style="-fx-padding:18;" alignment="CENTER">
				<!-- Repeatable Job Card -->
				<HBox spacing="0">
					<VBox prefWidth="160" spacing="8" style="-fx-border-color:#111; -fx-border-radius:10; -fx-background-radius:10; -fx-padding:12; -fx-background-color:white; -fx-effect: dropshadow(one-pass-box, rgba(0,0,0,0.08),6,0,0,2);">
						<Label text="#job1" style="-fx-font-weight:bold; -fx-font-size:16;" />
						<Label text="[description]" wrapText="true" style="-fx-text-fill:#444; -fx-font-size:12;" />
						<Label text="Avg salary - $x.xxx" style="-fx-font-size:12;" />
						<Label text="satisfaction - x / 5" style="-fx-font-size:12;" />
						<Region VBox.vgrow="ALWAYS" />
						<Button text="Learn more" style="-fx-background-color:#4c89d9; -fx-text-fill:white; -fx-background-radius:16; -fx-padding:6 16;" />
					</VBox>
				</HBox>

				<HBox spacing="0">
					<VBox prefWidth="160" spacing="8" style="-fx-border-color:#111; -fx-border-radius:10; -fx-background-radius:10; -fx-padding:12; -fx-background-color:white; -fx-effect: dropshadow(one-pass-box, rgba(0,0,0,0.08),6,0,0,2);">
						<Label text="#job2" style="-fx-font-weight:bold; -fx-font-size:16;" />

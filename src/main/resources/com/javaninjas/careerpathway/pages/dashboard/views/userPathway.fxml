						<Region VBox.vgrow="ALWAYS" />
						<Button text="Learn more" style="-fx-background-color:#4c89d9; -fx-text-fill:white; -fx-background-radius:16; -fx-padding:6 16;" />
					</VBox>
				</HBox>
			</HBox>

			<Label text="wanting more options? explore more" style="-fx-font-style:italic; -fx-text-fill:#666;" />
		</VBox>
	</center>

	<!-- Bottom navigation -->
	<bottom>
		<fx:include source="/com/javaninjas/careerpathway/core/views/bottomNav.fxml" />
	</bottom>
</BorderPane>


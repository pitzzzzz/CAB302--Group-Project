						<Button text="Learn more" style="-fx-background-color:#4c89d9; -fx-text-fill:white; -fx-background-radius:16; -fx-padding:6 16;" />
					</VBox>
				</HBox>

				<HBox spacing="0">
					<VBox prefWidth="160" spacing="8" style="-fx-border-color:#111; -fx-border-radius:10; -fx-background-radius:10; -fx-padding:12; -fx-background-color:white; -fx-effect: dropshadow(one-pass-box, rgba(0,0,0,0.08),6,0,0,2);">
						<Label text="#job3" style="-fx-font-weight:bold; -fx-font-size:16;" />
						<Label text="[description]" wrapText="true" style="-fx-text-fill:#444; -fx-font-size:12;" />

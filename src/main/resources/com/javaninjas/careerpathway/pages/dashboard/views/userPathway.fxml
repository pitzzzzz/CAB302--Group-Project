<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javaninjas.careerpathway.pages.dashboard.controllers.PathwayController" fx:id="rootPane">
    <BorderPane fx:id="mainContent">
        <!-- Top header -->
        <top>
            <AnchorPane style="-fx-padding:16;">
                <Button fx:id="logoutBtn" text="Logout" AnchorPane.rightAnchor="12" AnchorPane.topAnchor="8" style="-fx-background-radius:16; -fx-padding:6 12;" onAction="#handleLogout" />
            </AnchorPane>
        </top>

        <!-- Center content: recommended jobs / pathway dashboard with scroll -->
        <center>
            <VBox fx:id="mainContentContainer" spacing="0" style="-fx-background-color:#f7faff;">
                <!-- Fixed header section -->
                <VBox fx:id="headerSection" spacing="18" style="-fx-padding:32 32 24 32; -fx-alignment:CENTER;">
                    <Label fx:id="welcomeLabel" text="Welcome [name]," style="-fx-font-size:32; -fx-font-weight:bold; -fx-padding:0 0 8 0;" />
                    <Label fx:id="descriptionLabel" text="Here are the top careers we recommend for you" style="-fx-font-size:16; -fx-text-fill:#3a3a3a; -fx-padding:0 0 18 0;" />
                </VBox>

                <!-- Scrollable content area -->
                <ScrollPane fx:id="contentScrollPane" fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color:transparent;" vbarPolicy="AS_NEEDED" hbarPolicy="NEVER">
                    <VBox fx:id="scrollableContent" spacing="18" style="-fx-padding:0 32 32 32; -fx-alignment:CENTER;">
                        <!-- Job recommendations container (shown when no suggested career) -->
                        <VBox fx:id="jobRecommendationsSection" spacing="18" managed="true" visible="true">
                            <!-- Row of job cards: scrollable and responsive -->
                            <HBox fx:id="jobsContainer" spacing="18" style="-fx-padding:18; -fx-background-color:#fff; -fx-background-radius:16; -fx-border-radius:16; -fx-border-color:#e0e6ef; -fx-border-width:1;" alignment="CENTER" />
                            <Label text="Want more options? Explore more pathways!" style="-fx-font-style:italic; -fx-text-fill:#666; -fx-padding:12 0 0 0;" />
                        </VBox>

                        <!-- Weekly guide container (shown when suggested career exists) -->
                        <VBox fx:id="weeklyGuideSection" managed="false" visible="false" style="-fx-max-height: 500px; -fx-min-height: 300px; -fx-pref-height: 400px;">
                            <!-- Weekly guide header -->
                            <VBox spacing="16" style="-fx-padding: 0 0 16 0;">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <Label text="📚" style="-fx-font-size: 24px;" />
                                    <VBox spacing="4">
                                        <Label text="Your Learning Journey" style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #1e293b;" />
                                        <Label text="Follow this structured plan to achieve your career goals" style="-fx-font-size: 14px; -fx-text-fill: #64748b;" />
                                    </VBox>
                                </HBox>
                            </VBox>
                            
                            <ScrollPane fx:id="weeklyGuideScrollPane" fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color:transparent;" vbarPolicy="AS_NEEDED" hbarPolicy="NEVER" styleClass="weekly-guide-scroll">
                                <VBox fx:id="weeklyGuideContainer" spacing="16" style="-fx-padding: 8 0 24 0;">
                                    <!-- Weekly guide content will be added dynamically -->
                                </VBox>
                            </ScrollPane>
                        </VBox>
                    </VBox>
                </ScrollPane>
            </VBox>
        </center>

        <!-- Bottom navigation -->
        <bottom>
            <fx:include source="/com/javaninjas/careerpathway/core/views/bottomNav.fxml" />
        </bottom>
    </BorderPane>

    <!-- Blurred background -->
    <Pane fx:id="blurPane" style="-fx-background-color: rgba(0, 0, 0, 0.3);" visible="false" />

</StackPane>

        <center>
            <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: #f0f2f5; -fx-padding: 20;">
                <GridPane hgap="20" vgap="20" style="-fx-padding: 20;" maxWidth="1200" maxHeight="800">
                    <!-- 3 equal-width columns -->
                    <columnConstraints>
                        <ColumnConstraints percentWidth="33" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="33" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="33" hgrow="ALWAYS"/>
                    </columnConstraints>

                    <!-- 3 rows: top half split, bottom half full width -->
                    <rowConstraints>
                        <RowConstraints percentHeight="25" vgrow="ALWAYS"/>
                        <RowConstraints percentHeight="25" vgrow="ALWAYS"/>
                        <RowConstraints percentHeight="50" vgrow="ALWAYS"/>
                    </rowConstraints>

                    <!-- Left 2x2 Profile Card -->
                    <VBox alignment="CENTER" spacing="20"
                          style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25;
                         -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);"
                          GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="0" GridPane.rowSpan="2">

                        <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #7f8c8d;"
                               text="Main Profile Card (2x2)" />

                        <GridPane hgap="10" vgap="10" maxWidth="500">
                            <children>
                                <Label text="First Name" />
                                <Label fx:id="firstNameLabel" text="John" GridPane.columnIndex="1" />
                                <TextField fx:id="firstNameField" managed="false" visible="false" GridPane.columnIndex="1" />

                                <Label text="Last Name" GridPane.rowIndex="1" />
                                <Label fx:id="lastNameLabel" text="Doe" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                <TextField fx:id="lastNameField" managed="false" visible="false" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                <Label text="Email" GridPane.rowIndex="2" />
                                <Label fx:id="emailLabel" text="john.doe@example.com" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                <TextField fx:id="emailField" managed="false" visible="false" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                <Label text="Phone" GridPane.rowIndex="3" />
                                <Label fx:id="phoneLabel" text="123-456-7890" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                <TextField fx:id="phoneField" managed="false" visible="false" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                            </children>
                        </GridPane>

                        <HBox alignment="CENTER" spacing="10">
                            <Button fx:id="editButton" onAction="#handleEdit" text="Edit" />
                            <Button fx:id="saveButton" managed="false" onAction="#handleSave" text="Save" visible="false" />
                            <Button fx:id="cancelButton" managed="false" onAction="#handleCancel" text="Cancel" visible="false" />
                        </HBox>
                    </VBox>

                    <!-- Top Right Card -->
                    <VBox alignment="CENTER"
                          style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25;
                         -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);"
                          GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #7f8c8d;"
                               text="Top Right Card (2x2)" />
                    </VBox>

                    <!-- Bottom Right Card -->
                    <VBox alignment="CENTER"
                          style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25;
                         -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);"
                          GridPane.columnIndex="2" GridPane.rowIndex="1">
                        <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #7f8c8d;"
                               text="Bottom Right Card (2x2)" />
                    </VBox>

                    <!-- Full Width Bottom Card -->
                    <VBox alignment="CENTER"
                          style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25;
                         -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);"
                          GridPane.columnIndex="0" GridPane.columnSpan="3" GridPane.rowIndex="2">
                        <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #7f8c8d;"
                               text="Goals/Settings Card" />
                    </VBox>
                </GridPane>
            </ScrollPane>
        </center>


        <bottom>
        <fx:include source="/com/javaninjas/careerpathway/core/views/bottomNav.fxml" />
    </bottom>
</BorderPane>

</StackPane>

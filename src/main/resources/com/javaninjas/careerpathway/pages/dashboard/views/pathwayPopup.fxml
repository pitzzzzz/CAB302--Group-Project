<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.javaninjas.careerpathway.pages.dashboard.controllers.PathwayPopupController"
           prefWidth="520" prefHeight="520" minWidth="520" minHeight="520" maxWidth="520" maxHeight="520">

    <!-- The white rectangular modal; StackPane keeps this node its preferred size so the caller can center it -->
    <BorderPane fx:id="popupRoot" prefWidth="520" prefHeight="520" minWidth="520" minHeight="520" maxWidth="520" maxHeight="520" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.28), 18, 0.5, 0, 4);">

        <!-- Top: title + go back button -->
        <top>
            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding:18 22 0 22;">
                <Label fx:id="jobNameLabel" text="Job Title" style="-fx-font-size:36; -fx-font-weight:bold;" BorderPane.alignment="CENTER_LEFT" />
                <Pane HBox.hgrow="ALWAYS" />
                <Button text="go back" onAction="#handleClose" style="-fx-background-color:#e6e6e6; -fx-text-fill:#333; -fx-background-radius:18; -fx-padding:8 14; -fx-font-weight:bold;" />
            </HBox>
        </top>

        <!-- Center: main content -->
        <center>
            <VBox spacing="12" style="-fx-padding:18 28;">
                <Label fx:id="jobDescriptionLabel" wrapText="true" style="-fx-font-size:14; -fx-text-fill:#333;" />

                <HBox spacing="20" alignment="CENTER_LEFT">
                    <Label text="Avg salary -" style="-fx-font-weight:bold;" />
                    <Label fx:id="salaryLabel" />
                </HBox>
                <Label text="satisfaction - x / 5" />

                <HBox spacing="18" alignment="CENTER" style="-fx-padding:12 0;">
                    <Region style="-fx-pref-width:16;" />
                    <!-- three benefit tiles -->
                    <HBox spacing="14" alignment="CENTER">
                        <VBox alignment="CENTER" style="-fx-border-color:#dcdcdc; -fx-border-radius:14; -fx-background-radius:14; -fx-padding:18; -fx-pref-width:160; -fx-pref-height:80;">
                            <Label text="benefit #1" style="-fx-font-weight:bold;" />
                            <Label text="e.g. hybrid role" style="-fx-font-size:12; -fx-text-fill:#666;" />
                        </VBox>
                        <VBox alignment="CENTER" style="-fx-border-color:#dcdcdc; -fx-border-radius:14; -fx-background-radius:14; -fx-padding:18; -fx-pref-width:160; -fx-pref-height:80;">
                            <Label text="benefit #2" style="-fx-font-weight:bold;" />
                            <Label text="e.g. high starting salary" style="-fx-font-size:12; -fx-text-fill:#666;" />
                        </VBox>
                        <VBox alignment="CENTER" style="-fx-border-color:#dcdcdc; -fx-border-radius:14; -fx-background-radius:14; -fx-padding:18; -fx-pref-width:160; -fx-pref-height:80;">
                            <Label text="benefit #3" style="-fx-font-weight:bold;" />
                            <Label text="e.g. problem solving" style="-fx-font-size:12; -fx-text-fill:#666;" />
                        </VBox>
                    </HBox>
                </HBox>

                <!-- spacer -->
                <Region prefHeight="20" />

                <!-- Radio questions and CTA placed in an HBox: left radios, right CTA -->
                <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-padding:8 0 12 0;">
                    <VBox spacing="12">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <RadioButton />
                            <Label text="have you heard of this career before?" />
                        </HBox>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <RadioButton />
                            <Label text="do you have any experience in this field?" />
                        </HBox>
                    </VBox>

                    <Pane HBox.hgrow="ALWAYS" />

                    <Button text="Select This Career" onAction="#handleSelectCourse" style="-fx-background-color:#4c89d9; -fx-text-fill:white; -fx-background-radius:24; -fx-padding:14 28; -fx-font-size:12; -fx-font-weight:bold;" />
                </HBox>

                <!-- Course info area (kept but compact) -->
                <Separator />
                <Label text="Related Course" style="-fx-font-size:16; -fx-font-weight:bold;" />
                <GridPane hgap="12" vgap="8">
                    <Label text="Course Name:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight:bold;" />
                    <Label fx:id="courseNameLabel" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                    <Label text="Major:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight:bold;" />
                    <Label fx:id="courseMajorLabel" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                    <Label text="Course Code:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight:bold;" />
                    <Label fx:id="courseCodeLabel" GridPane.rowIndex="2" GridPane.columnIndex="1" />

                    <Label text="QTAC Code:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight:bold;" />
                    <Label fx:id="qtacCodeLabel" GridPane.rowIndex="3" GridPane.columnIndex="1" />

                    <Label text="Description:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-weight:bold;" />
                    <Label fx:id="courseDescriptionLabel" wrapText="true" GridPane.rowIndex="4" GridPane.columnIndex="1" />
                </GridPane>
            </VBox>
        </center>

    </BorderPane>

</StackPane>

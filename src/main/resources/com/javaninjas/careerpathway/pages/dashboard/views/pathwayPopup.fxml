<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.javaninjas.careerpathway.pages.dashboard.controllers.PathwayPopupController"
           prefWidth="600" prefHeight="520" minWidth="550" minHeight="450" maxWidth="700" maxHeight="600">

    <!-- Modern responsive modal container -->
    <BorderPane fx:id="popupRoot" prefWidth="600" prefHeight="520" style="-fx-background-color: white; -fx-background-radius: 20; -fx-border-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 24, 0.3, 0, 6);">

        <!-- Modern header with improved styling -->
        <top>
            <VBox style="-fx-padding: 24 28 0 28;">
                <!-- Header row with title and close button -->
                <HBox alignment="CENTER_LEFT" spacing="16">
                    <Label fx:id="jobNameLabel" text="Job Title" 
                           style="-fx-font-size: 28; -fx-font-weight: 700; -fx-text-fill: #1e293b;" 
                           wrapText="true" HBox.hgrow="ALWAYS" />
                    <Button text="✕" onAction="#handleClose" 
                            style="-fx-background-color: #f1f5f9; -fx-text-fill: #64748b; -fx-background-radius: 50; -fx-padding: 8 12; -fx-font-size: 16; -fx-font-weight: 600; -fx-border: none; -fx-cursor: hand;" />
                </HBox>
                
                <!-- Separator -->
                <Region prefHeight="16" />
            </VBox>
        </top>

        <!-- Modern main content with improved layout -->
        <center>
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                <VBox spacing="24" style="-fx-padding: 0 28 24 28;">
                    
                    <!-- Job description card -->
                    <VBox spacing="12" style="-fx-background-color: #f8fafc; -fx-background-radius: 16; -fx-padding: 20; -fx-border-color: #e2e8f0; -fx-border-radius: 16; -fx-border-width: 1;">
                        <Label text="About this career" style="-fx-font-size: 16; -fx-font-weight: 600; -fx-text-fill: #374151;" />
                        <Label fx:id="jobDescriptionLabel" wrapText="true" 
                               style="-fx-font-size: 14; -fx-text-fill: #6b7280; -fx-line-spacing: 2;" />
                    </VBox>
                    
                    <!-- Salary and satisfaction info -->
                    <HBox spacing="24" alignment="CENTER_LEFT">
                        <VBox spacing="6" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16; -fx-border-color: #e2e8f0; -fx-border-radius: 12; -fx-border-width: 1;" HBox.hgrow="ALWAYS">
                            <Label text="Average Salary" style="-fx-font-size: 12; -fx-font-weight: 600; -fx-text-fill: #6b7280; -fx-text-transform: uppercase;" />
                            <Label fx:id="salaryLabel" style="-fx-font-size: 20; -fx-font-weight: 700; -fx-text-fill: #059669;" />
                        </VBox>
                        <VBox spacing="6" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16; -fx-border-color: #e2e8f0; -fx-border-radius: 12; -fx-border-width: 1;" HBox.hgrow="ALWAYS">
                            <Label text="Job Satisfaction" style="-fx-font-size: 12; -fx-font-weight: 600; -fx-text-fill: #6b7280; -fx-text-transform: uppercase;" />
                            <Label text="4.2 / 5" style="-fx-font-size: 20; -fx-font-weight: 700; -fx-text-fill: #3b82f6;" />
                        </VBox>
                    </HBox>

                    <!-- Modern benefits/features section -->
                    <VBox spacing="16">
                        <Label text="Key Benefits" style="-fx-font-size: 16; -fx-font-weight: 600; -fx-text-fill: #374151;" />
                        <HBox spacing="16" alignment="CENTER">
                            <VBox alignment="CENTER" spacing="8" HBox.hgrow="ALWAYS" 
                                  style="-fx-background-color: #fef3c7; -fx-background-radius: 12; -fx-padding: 16; -fx-border-color: #f59e0b; -fx-border-radius: 12; -fx-border-width: 1;">
                                <Label text="💼" style="-fx-font-size: 24;" />
                                <Label text="Flexible Work" style="-fx-font-weight: 600; -fx-font-size: 12; -fx-text-fill: #92400e;" />
                                <Label text="Remote options" style="-fx-font-size: 11; -fx-text-fill: #b45309; -fx-text-alignment: center;" wrapText="true" />
                            </VBox>
                            <VBox alignment="CENTER" spacing="8" HBox.hgrow="ALWAYS"
                                  style="-fx-background-color: #ecfdf5; -fx-background-radius: 12; -fx-padding: 16; -fx-border-color: #10b981; -fx-border-radius: 12; -fx-border-width: 1;">
                                <Label text="💰" style="-fx-font-size: 24;" />
                                <Label text="High Growth" style="-fx-font-weight: 600; -fx-font-size: 12; -fx-text-fill: #065f46;" />
                                <Label text="Strong salary potential" style="-fx-font-size: 11; -fx-text-fill: #047857; -fx-text-alignment: center;" wrapText="true" />
                            </VBox>
                            <VBox alignment="CENTER" spacing="8" HBox.hgrow="ALWAYS"
                                  style="-fx-background-color: #eff6ff; -fx-background-radius: 12; -fx-padding: 16; -fx-border-color: #3b82f6; -fx-border-radius: 12; -fx-border-width: 1;">
                                <Label text="🧠" style="-fx-font-size: 24;" />
                                <Label text="Innovation" style="-fx-font-weight: 600; -fx-font-size: 12; -fx-text-fill: #1e40af;" />
                                <Label text="Problem solving" style="-fx-font-size: 11; -fx-text-fill: #1d4ed8; -fx-text-alignment: center;" wrapText="true" />
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Quick assessment and CTA -->
                    <VBox spacing="20" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 24; -fx-border-color: #e2e8f0; -fx-border-radius: 16; -fx-border-width: 1;">
                        <VBox spacing="16">
                            <Label text="Quick Assessment" style="-fx-font-size: 16; -fx-font-weight: 600; -fx-text-fill: #374151;" />
                            <VBox spacing="12">
                                <HBox spacing="12" alignment="CENTER_LEFT">
                                    <RadioButton style="-fx-text-fill: #6b7280;" />
                                    <Label text="Have you heard of this career before?" style="-fx-font-size: 14; -fx-text-fill: #6b7280;" />
                                </HBox>
                                <HBox spacing="12" alignment="CENTER_LEFT">
                                    <RadioButton style="-fx-text-fill: #6b7280;" />
                                    <Label text="Do you have any experience in this field?" style="-fx-font-size: 14; -fx-text-fill: #6b7280;" />
                                </HBox>
                            </VBox>
                        </VBox>
                        
                        <!-- CTA Button -->
                        <HBox alignment="CENTER">
                            <Button text="Select This Career" onAction="#handleSelectCourse" 
                                    style="-fx-background-color: linear-gradient(to bottom, #3b82f6, #2563eb); -fx-text-fill: white; -fx-background-radius: 16; -fx-padding: 16 32; -fx-font-size: 14; -fx-font-weight: 600; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(59,130,246,0.3), 8, 0.3, 0, 2);" />
                        </HBox>
                    </VBox>

                    <!-- Course information section -->
                    <VBox spacing="16" style="-fx-background-color: #f8fafc; -fx-background-radius: 16; -fx-padding: 20; -fx-border-color: #e2e8f0; -fx-border-radius: 16; -fx-border-width: 1;">
                        <Label text="Related Course" style="-fx-font-size: 16; -fx-font-weight: 600; -fx-text-fill: #374151;" />
                        
                        <VBox spacing="12">
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <Label text="Course:" style="-fx-font-weight: 600; -fx-font-size: 12; -fx-text-fill: #6b7280; -fx-min-width: 80;" />
                                <Label fx:id="courseNameLabel" style="-fx-font-size: 14; -fx-text-fill: #374151;" wrapText="true" HBox.hgrow="ALWAYS" />
                            </HBox>
                            
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <Label text="Major:" style="-fx-font-weight: 600; -fx-font-size: 12; -fx-text-fill: #6b7280; -fx-min-width: 80;" />
                                <Label fx:id="courseMajorLabel" style="-fx-font-size: 14; -fx-text-fill: #374151;" />
                            </HBox>
                            
                            <HBox spacing="24">
                                <HBox spacing="8" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                                    <Label text="Code:" style="-fx-font-weight: 600; -fx-font-size: 12; -fx-text-fill: #6b7280;" />
                                    <Label fx:id="courseCodeLabel" style="-fx-font-size: 14; -fx-text-fill: #374151; -fx-background-color: #e5e7eb; -fx-background-radius: 6; -fx-padding: 4 8;" />
                                </HBox>
                                <HBox spacing="8" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                                    <Label text="QTAC:" style="-fx-font-weight: 600; -fx-font-size: 12; -fx-text-fill: #6b7280;" />
                                    <Label fx:id="qtacCodeLabel" style="-fx-font-size: 14; -fx-text-fill: #374151; -fx-background-color: #dbeafe; -fx-background-radius: 6; -fx-padding: 4 8;" />
                                </HBox>
                            </HBox>
                            
                            <VBox spacing="6">
                                <Label text="Description:" style="-fx-font-weight: 600; -fx-font-size: 12; -fx-text-fill: #6b7280;" />
                                <Label fx:id="courseDescriptionLabel" wrapText="true" 
                                       style="-fx-font-size: 13; -fx-text-fill: #6b7280; -fx-line-spacing: 1.5;" />
                            </VBox>
                        </VBox>
                    </VBox>
                    
                </VBox>
            </ScrollPane>
        </center>

    </BorderPane>

</StackPane>

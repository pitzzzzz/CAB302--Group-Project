<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.javaninjas.careerpathway.pages.quizResults.controllers.QuizResultController"
            prefWidth="480"
            prefHeight="800"
            styleClass="root">

    <!-- Header -->
    <top>
        <VBox alignment="TOP_CENTER" spacing="16">
            <StackPane prefHeight="120" minHeight="120" maxHeight="120">
                <Pane prefHeight="100" style="-fx-background-color:#e6e6e6; -fx-background-radius:0 0 40 40;" />
                <fx:include fx:id="progressDots" source="../../../core/ProgressDots.fxml" StackPane.alignment="TOP_CENTER" VBox.vgrow="ALWAYS" />
                <Ellipse radiusX="300" radiusY="60" fill="white" strokeWidth="0"
                         StackPane.alignment="BOTTOM_CENTER" translateY="30"/>
            </StackPane>
        </VBox>
    </top>

    <!-- Main content card -->
    <center>
        <VBox spacing="18" alignment="TOP_CENTER" styleClass="card">
            <Label text="You're All Set!" styleClass="header"/>
            <Label text="here's what we've learned so far..." styleClass="subtitle"/>
            <VBox fx:id="detailsBox" spacing="8" alignment="TOP_LEFT" styleClass="card-content"/>
        </VBox>
    </center>

    <!-- Bottom controls -->
    <bottom>
        <VBox alignment="CENTER" spacing="6" prefWidth="420" style="-fx-padding:12;">
            <Button fx:id="dashboardButton" text="Go To Dashboard" maxWidth="Infinity" prefHeight="44"
                    styleClass="primary-btn"
                    onAction="#goToDashboard"/>
        </VBox>
    </bottom>
</BorderPane>

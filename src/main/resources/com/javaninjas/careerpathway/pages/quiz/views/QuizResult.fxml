<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.javaninjas.careerpathway.pages.results.controllers.QuizResultController"
            prefWidth="480"
            prefHeight="800"
            styleClass="root">

    <!-- Header -->
    <top>
        <VBox alignment="TOP_CENTER" spacing="12" style="-fx-background-color: #f7f7fa; -fx-padding: 32 0 0 0;">
            <Label text="Quiz Results" styleClass="header" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #3a3a3a;" />
            <Label text="Here's what we've learned about you!" styleClass="subtitle" style="-fx-font-size: 16px; -fx-text-fill: #666;" />
        </VBox>
    </top>

    <!-- Main content card -->
    <center>
        <VBox spacing="18" alignment="TOP_CENTER" style="-fx-padding: 32;">
            <VBox style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 32; -fx-effect: dropshadow(gaussian, #d1d1d1, 12, 0.2, 0, 2);">
                <Label text="You're All Set!" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2a2a2a; -fx-padding: 0 0 12 0;" />
                <Label text="See your personalized insights below." style="-fx-font-size: 14px; -fx-text-fill: #888; -fx-padding: 0 0 18 0;" />
                <Separator />
                <VBox fx:id="detailsBox" spacing="12" alignment="TOP_LEFT" style="-fx-padding: 18 0 0 0;" />
            </VBox>
        </VBox>
    </center>

    <!-- Bottom controls -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-padding: 32 0 32 0;">
            <Region minWidth="0" HBox.hgrow="ALWAYS" />
            <Button fx:id="dashboardButton" text="Go To Dashboard"
                    minWidth="180" maxWidth="240" prefHeight="44"
                    style="-fx-background-color: linear-gradient(to right, #4f8cff, #6a7cff); -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 22; -fx-effect: dropshadow(gaussian, #b3c6ff, 8, 0.2, 0, 2);"
                    onAction="#goToDashboard"/>
            <Region minWidth="0" HBox.hgrow="ALWAYS" />
        </HBox>
    </bottom>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import com.javaninjas.careerpathway.pages.quiz.components.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" styleClass="root" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javaninjas.careerpathway.pages.quiz.controllers.QuizQuestionController">

    <VBox alignment="CENTER" spacing="20" style="-fx-padding:12 20;">

        <!-- Header with progress dots -->
        <VBox alignment="TOP_CENTER" spacing="8">
            <ProgressDots fx:id="progressDots" />
        </VBox>

        <!-- Quiz content card -->
        <VBox fx:id="questionsContainer" alignment="CENTER" maxWidth="720" prefWidth="520" spacing="18" style="-fx-padding:28; -fx-background-radius:12; -fx-effect: dropshadow(two-pass-box, rgba(0,0,0,0.08), 10, 0, 0, 4);" styleClass="card">
            <!-- Question content will be dynamically added here by the controller -->
        </VBox>

        <!-- Bottom controls -->
        <HBox alignment="CENTER" spacing="24">
            <Button fx:id="prevButton" onAction="#handlePrev" prefHeight="44" prefWidth="180" style="-fx-background-color:#357abd; -fx-text-fill:white; -fx-font-weight:600; -fx-background-radius:10;" text="Go Back" />

            <Button fx:id="nextButton" onAction="#handleNext" prefHeight="44" prefWidth="180" style="-fx-background-color:#357ABD; -fx-text-fill:white; -fx-font-weight:700; -fx-background-radius:10;" text="Continue" />

            <Button fx:id="submitButton"
                    onAction="#handleSubmit"
                    text="Submit"
                    prefWidth="180"
                    prefHeight="44"
                    visible="false"
                    managed="false"
                    style="-fx-background-color:#28A745; -fx-text-fill:white; -fx-font-weight:700; -fx-background-radius:10;" />
        </HBox>
    </VBox>
</ScrollPane>

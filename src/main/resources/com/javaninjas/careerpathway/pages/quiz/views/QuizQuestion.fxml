<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Ellipse?>
<?import com.javaninjas.careerpathway.pages.quiz.components.ProgressDots?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.javaninjas.careerpathway.pages.quiz.controllers.QuizQuestionController"
            prefWidth="480"
            prefHeight="800"
            styleClass="root">

    <!-- Header with progress dots and page indicator -->
    <top>
        <VBox alignment="TOP_CENTER" spacing="8" style="-fx-padding:12 20 6 20;">
            <StackPane prefHeight="40" minHeight="40" maxHeight="40">
                <!-- header background removed; only progress dots will be shown below -->
            </StackPane>

            <!-- Progress dots centered at top -->
            <StackPane style="-fx-padding:8 12 0 12;" prefHeight="40">
                <ProgressDots fx:id="progressDots"
                              StackPane.alignment="CENTER" />
            </StackPane>
        </VBox>
    </top>

    <!-- Quiz content card: center the card and its children -->
    <center>
        <StackPane BorderPane.alignment="CENTER" style="-fx-padding:18 12 18 12;">
            <VBox fx:id="questionsContainer"
                  alignment="CENTER"
                  spacing="18"
                  prefWidth="520"
                  maxWidth="720"
                  styleClass="card"
                  style="-fx-padding:28; -fx-background-radius:12; -fx-effect: dropshadow(two-pass-box, rgba(0,0,0,0.08), 10, 0, 0, 4);">
                <!-- Question content will be dynamically added here by the controller -->
            </VBox>
        </StackPane>
    </center>

    <!-- Bottom controls: pinned to bottom center -->
    <bottom>
        <VBox alignment="CENTER" spacing="12" style="-fx-padding:12 20 24 20;">
            <HBox alignment="CENTER" spacing="24">
                <Button fx:id="prevButton"
                        onAction="#handlePrev"
                        text="Go Back"
                        prefWidth="180"
                        prefHeight="44"
                        style="-fx-background-color:#95B4DB; -fx-text-fill:white; -fx-font-weight:600; -fx-background-radius:10;" />

                <Button fx:id="nextButton"
                        onAction="#handleNext"
                        text="Continue"
                        prefWidth="180"
                        prefHeight="44"
                        style="-fx-background-color:#357ABD; -fx-text-fill:white; -fx-font-weight:700; -fx-background-radius:10;" />

                <Button fx:id="submitButton"
                        onAction="#handleSubmit"
                        text="Submit"
                        prefWidth="180"
                        prefHeight="44"
                        visible="false"
                        style="-fx-background-color:#28A745; -fx-text-fill:white; -fx-font-weight:700; -fx-background-radius:10;" />
            </HBox>
        </VBox>
    </bottom>
</BorderPane>

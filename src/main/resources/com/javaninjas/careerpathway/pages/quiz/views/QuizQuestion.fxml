<?xml version="1.0" encoding="UTF-8"?>

<?import com.javaninjas.careerpathway.pages.quiz.components.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane styleClass="root" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javaninjas.careerpathway.pages.quiz.controllers.QuizQuestionController">

    <!-- Top: Header with progress dots -->
    <top>
        <VBox fx:id="headerBox" alignment="TOP_CENTER" spacing="8" style="-fx-padding:12 20 8 20;">
            <ProgressDots fx:id="progressDots" />
        </VBox>
    </top>

    <!-- Center: Card that will expand to available space -->
    <center>
        <VBox alignment="CENTER" spacing="20" style="-fx-padding:12 20 8 20;">
            <VBox fx:id="questionsContainer" alignment="TOP_CENTER" maxWidth="720" prefWidth="720" prefHeight="0.0" maxHeight="Infinity" spacing="18" style="-fx-padding:28; -fx-background-radius:12; -fx-effect: dropshadow(two-pass-box, rgba(0,0,0,0.08), 10, 0, 0, 4); -fx-background-color: white;" styleClass="card">
                <ScrollPane fx:id="cardScroll" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-padding:0; -fx-background-insets: 0; -fx-border-width:0;">
                    <content>
                        <VBox fx:id="questionsBox" alignment="TOP_CENTER" spacing="18" style="-fx-padding:0 0 0 0;" />
                    </content>
                </ScrollPane>
            </VBox>
            <VBox.vgrow>
                <Priority fx:constant="ALWAYS" />
            </VBox.vgrow>
        </VBox>
    </center>

    <!-- Bottom: Controls -->
    <bottom>
        <HBox fx:id="controlsBox" alignment="CENTER" spacing="24" style="-fx-padding:12 20 20 20;">
            <Button fx:id="prevButton" onAction="#handlePrev" prefHeight="44" prefWidth="180" style="-fx-background-color:#357abd; -fx-text-fill:white; -fx-font-weight:600; -fx-background-radius:10;" text="Go Back" />

            <Button fx:id="nextButton" onAction="#handleNext" prefHeight="44" prefWidth="180" style="-fx-background-color:#357ABD; -fx-text-fill:white; -fx-font-weight:700; -fx-background-radius:10;" text="Continue" />

            <Button fx:id="submitButton"
                    onAction="#handleSubmit"
                    text="Submit"
                    prefWidth="180"
                    prefHeight="44"
                    visible="false"
                    managed="false"
                    style="-fx-background-color:#28A745; -fx-text-fill:white; -fx-font-weight:700; -fx-background-radius:10;" />
        </HBox>
    </bottom>
</BorderPane>

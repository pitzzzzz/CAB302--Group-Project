<?xml version="1.0" encoding="UTF-8"?>

<?import com.javaninjas.careerpathway.pages.quiz.components.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane styleClass="root" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javaninjas.careerpathway.pages.quiz.controllers.QuizIntroController">

    <!-- Header with progress dots -->
    <top>
        <VBox alignment="TOP_CENTER" spacing="8" style="-fx-padding:12 20 6 20;">
            <StackPane prefHeight="40">
                <ProgressDots fx:id="progressDots" StackPane.alignment="CENTER"/>
            </StackPane>
        </VBox>
    </top>
    <!-- Main content card: place original intro content inside a centered card -->
    <center>
        <StackPane style="-fx-padding:18 12 18 12;" BorderPane.alignment="CENTER">
            <VBox alignment="CENTER" prefWidth="360" spacing="14" style="-fx-padding:28; -fx-background-radius:12; -fx-effect: dropshadow(two-pass-box, rgba(0,0,0,0.06), 8, 0, 0, 4);" styleClass="card">
                <!-- preserve original content text -->
                <Label styleClass="header" text="Lets get started..." wrapText="true" />
                <Label styleClass="subtitle" text="This short quiz will help us personalize your career pathway." wrapText="true" />
                <ImageView fitWidth="500.0" preserveRatio="true">
                    <Image url="@/com/javaninjas/careerpathway/Assets/Test.png" />
                </ImageView>
                <Button fx:id="startButton" onAction="#startQuiz" prefHeight="44" prefWidth="360" style="-fx-background-color:#357ABD; -fx-text-fill:white; -fx-font-weight:700; -fx-background-radius:10;" text="Continue" />
            </VBox>
        </StackPane>
    </center>
</BorderPane>

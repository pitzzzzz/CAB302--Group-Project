<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<VBox xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaninjas.careerpathway.pages.quiz.controllers.QuizIntroController"
      alignment="TOP_CENTER"
      spacing="20"
      prefWidth="480"
      prefHeight="640"
      styleClass="root">


    <!-- Header with gradient background -->
    <StackPane prefHeight="180" maxWidth="Infinity" VBox.vgrow="NEVER"
               style="-fx-background-color: linear-gradient(to bottom right, #dbeafe, #bfdbfe);
                      -fx-background-radius: 0 0 40 40;">
        <!-- Progress dots -->
        <HBox spacing="10" alignment="CENTER" StackPane.alignment="BOTTOM_CENTER" translateY="-15">
            <Circle radius="6" styleClass="dot-active"/>
            <Circle radius="5" styleClass="dot"/>
            <Circle radius="5" styleClass="dot"/>
            <Circle radius="5" styleClass="dot"/>
            <Circle radius="5" styleClass="dot"/>
            <Circle radius="5" styleClass="dot"/>
        </HBox>
    </StackPane>

    <!-- Main content card -->
    <VBox alignment="CENTER" spacing="14" prefWidth="360" styleClass="card">
        <Label text="Let’s get started..." wrapText="true" styleClass="header"/>
        <Label text="This short quiz will help us personalize your career pathway."
               wrapText="true" styleClass="subtitle"/>
        <Region prefHeight="30"/>
        <Button fx:id="startButton" onAction="#startQuiz" text="Continue" prefWidth="220" prefHeight="44" styleClass="primary-btn"/>
    </VBox>

    <!-- Flexible spacer -->
    <Region VBox.vgrow="ALWAYS"/>
</VBox>

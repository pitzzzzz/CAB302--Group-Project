<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import com.javaninjas.careerpathway.pages.quiz.components.ProgressDots?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.javaninjas.careerpathway.pages.quiz.controllers.QuizIntroController"
            prefWidth="480"
            prefHeight="800"
            styleClass="root">

    <!-- Header -->
    <top>
        <VBox alignment="TOP_CENTER" spacing="16">
            <StackPane prefHeight="120" minHeight="120" maxHeight="120">
                <Pane prefHeight="100"
                      style="-fx-background-color:#e6e6e6; -fx-background-radius:0 0 40 40;" />

                <!-- Custom ProgressDots component -->
                <com.javaninjas.careerpathway.pages.quiz.components.ProgressDots
                    StackPane.alignment="TOP_CENTER"
                    VBox.vgrow="ALWAYS" />

                <Ellipse radiusX="300" radiusY="60"
                         fill="white"
                         strokeWidth="0"
                         StackPane.alignment="BOTTOM_CENTER"
                         translateY="30"/>
            </StackPane>
        </VBox>
    </top>

    <!-- Main content card -->
    <center>
        <VBox alignment="CENTER" spacing="14" prefWidth="360" styleClass="card">
            <Label text="Let’s get started..." wrapText="true" styleClass="header"/>
            <Label text="This short quiz will help us personalize your career pathway."
                   wrapText="true" styleClass="subtitle"/>
        </VBox>
    </center>

    <!-- Bottom controls -->
    <bottom>
        <VBox alignment="CENTER" spacing="6" prefWidth="420" style="-fx-padding:12;">
            <Button fx:id="startButton"
                    onAction="#startQuiz"
                    text="Continue"
                    maxWidth="Infinity"
                    prefHeight="44"
                    styleClass="primary-btn"/>
        </VBox>
    </bottom>
</BorderPane>
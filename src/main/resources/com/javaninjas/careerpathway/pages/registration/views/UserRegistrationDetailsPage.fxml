<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane alignment="CENTER" styleClass="root" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javaninjas.careerpathway.pages.registration.controllers.UserRegistrationController">

	<!-- Top nav -->
	<AnchorPane>
		<StackPane.alignment>TOP_LEFT</StackPane.alignment>
		<fx:include source="/com/javaninjas/careerpathway/core/components/views/topNavBack.fxml" AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0" />
	</AnchorPane>

	<!-- Main content container -->
	<VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefWidth="500.0" spacing="20">

		<!-- Page header -->
		<VBox alignment="CENTER" maxWidth="-Infinity" spacing="6">
			<Label styleClass="header" text="Create your account" />
			<Label maxWidth="320" styleClass="subtitle" text="A few quick details and you're ready to start" wrapText="true" />
		</VBox>

		<!-- Registration form card -->
		<VBox alignment="CENTER" maxWidth="-Infinity" spacing="14" styleClass="card">
			<padding>
				<Insets bottom="18" left="18" right="18" top="18" />
			</padding>

			<!-- Name row -->
			<HBox alignment="CENTER" spacing="10">
				<TextField fx:id="firstNameField" prefWidth="140" promptText="First name" styleClass="text-field" />
				<TextField fx:id="lastNameField" prefWidth="140" promptText="Last name" styleClass="text-field" />
			</HBox>

			<!-- Email -->
			<TextField fx:id="emailField" prefWidth="280" promptText="Email address" styleClass="text-field" />

			<!-- Password -->
			<PasswordField fx:id="passwordField" prefWidth="280" promptText="Choose a password" styleClass="text-field" />

			<!-- City -->
			<TextField fx:id="cityField" prefWidth="280" promptText="City" styleClass="text-field" />

			<!-- Section header -->
			<Label maxWidth="280" styleClass="section-header" text="A few more details to personalise your experience" wrapText="true" />

			<!-- Age & Stage -->
			<HBox alignment="CENTER" spacing="12">
				<ComboBox fx:id="ageSelect" prefWidth="130" promptText="Age" styleClass="combo-box" />
				<ComboBox fx:id="profileStage" prefWidth="130" promptText="Stage" styleClass="combo-box" />
			</HBox>

			<!-- Anonymous checkbox -->
			<HBox alignment="CENTER_LEFT" maxWidth="280" spacing="8">
				<CheckBox fx:id="anonymousCheck" />
				<Label styleClass="label-muted" text="Keep my account anonymous" />
			</HBox>

			<!-- Helper text -->
			<Label maxWidth="260" styleClass="label-small" text="We'll never share your personal info without consent." wrapText="true" />

			<!-- Register button -->
			<Button fx:id="registerButton" onAction="#onRegister" prefHeight="44" prefWidth="240" styleClass="primary-btn" text="Create account" />

		</VBox>

	</VBox>

</StackPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaninjas.careerpathway.pages.registration.controllers.RegistrationPageController"
      spacing="18"
      fillWidth="true"
      styleClass="root">

    <!-- top nav -->
    <fx:include source="/com/javaninjas/careerpathway/core/components/views/topNavBack.fxml"/>

    <!-- Hero header with subtle gradient and centered text -->
    <StackPane prefHeight="180" maxWidth="Infinity"
               style="-fx-background-color: linear-gradient(to bottom right, #eef6ff, #f8fbff);
                      -fx-background-radius: 0 0 28 28;">
        <VBox alignment="CENTER" spacing="8">
            <Label text="Choose a career with confidence"
                   wrapText="true"
                   styleClass="hero-title"/>
            <Label text="Find clarity, discover your best-fit jobs, and avoid wasting years on the wrong path — all in just a few minutes."
                   wrapText="true"
                   styleClass="hero-subtitle"
                   maxWidth="680"/>
        </VBox>
    </StackPane>

    <!-- Feature cards: horizontal, scrollable on small widths -->
    <ScrollPane fitToWidth="true" hbarPolicy="AS_NEEDED" vbarPolicy="NEVER" style="-fx-background-color:transparent;">
        <HBox spacing="20" alignment="TOP_CENTER">
            <padding>
                <Insets top="18" bottom="18" left="28" right="28"/>
            </padding>

            <!-- Feature 1 -->
            <VBox spacing="10" alignment="TOP_LEFT" styleClass="feature-card" prefWidth="320" minHeight="180">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Circle radius="18" style="-fx-fill: #e6f0ff; -fx-stroke: #cfe0ff;" />
                    <Label text="Clarity" style="-fx-font-weight:700; -fx-font-size:13px; -fx-text-fill:#111827;" />
                </HBox>

                <Label text="Get full clarity on your career direction" wrapText="true"
                       styleClass="feature-title"/>

                <Label text="No more guessing — our guided quiz helps you uncover careers that match your strengths and interests."
                       wrapText="true" styleClass="feature-desc"/>
            </VBox>

            <!-- Feature 2 -->
            <VBox spacing="10" alignment="TOP_LEFT" styleClass="feature-card" prefWidth="320" minHeight="180">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Circle radius="18" style="-fx-fill: #ffeef6; -fx-stroke: #ffdbe9;" />
                    <Label text="Tailored" style="-fx-font-weight:700; -fx-font-size:13px; -fx-text-fill:#111827;" />
                </HBox>

                <Label text="Discover jobs tailored to your goals" wrapText="true" styleClass="feature-title"/>

                <Label text="Answers shape a personalized pathway aligned with your ambitions, lifestyle, and values."
                       wrapText="true" styleClass="feature-desc"/>
            </VBox>

            <!-- Feature 3 -->
            <VBox spacing="10" alignment="TOP_LEFT" styleClass="feature-card" prefWidth="320" minHeight="180">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Circle radius="18" style="-fx-fill: #eefbe6; -fx-stroke: #d7f7c9;" />
                    <Label text="Save time" style="-fx-font-weight:700; -fx-font-size:13px; -fx-text-fill:#111827;" />
                </HBox>

                <Label text="Reduce years of wasted study &amp; debt" wrapText="true" styleClass="feature-title"/>

                <Label text="See which paths are worth your focus — avoid costly mistakes and get ahead faster."
                       wrapText="true" styleClass="feature-desc"/>
            </VBox>

        </HBox>
    </ScrollPane>

    <!-- CTA area -->
    <VBox alignment="CENTER" spacing="12">
        <padding>
            <Insets top="6" bottom="24" left="36" right="36"/>
        </padding>
        <Button fx:id="createAccountButton"
                onAction="#handleCreateAccount"
                text="Create Account"
                prefWidth="380" prefHeight="52"
                styleClass="primary-btn"/>
    </VBox>

</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>

<HBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaninjas.careerpathway.core.controllers.BottomNavController"
      alignment="CENTER" spacing="20" style="-fx-padding: 12; -fx-border-color: #d0d0d0; -fx-border-width: 1 0 0 0;">
    <Button fx:id="exploreBtn" onAction="#handleExplore" styleClass="bottom-nav-button" text="Explore" HBox.hgrow="ALWAYS" />
    <Button fx:id="pathwayBtn" onAction="#handlePathway" styleClass="bottom-nav-button" text="Your Pathway" HBox.hgrow="ALWAYS" />
    <Button fx:id="profileBtn" onAction="#handleProfile" styleClass="bottom-nav-button" text="Profile" HBox.hgrow="ALWAYS" />
</HBox>

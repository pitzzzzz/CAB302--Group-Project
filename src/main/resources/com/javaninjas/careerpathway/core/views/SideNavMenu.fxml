<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Root container for the side menu -->
<VBox fx:id="sideMenuContainer" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaninjas.careerpathway.core.controllers.SideNavMenuController"
      prefWidth="250" maxWidth="250"
      style="-fx-background-color: #2c3e50; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 10, 0, 2, 0);">

    <!-- Menu Header with close button -->
    <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 20 0;">
        <Label text="Menu" style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;" />
        <Region HBox.hgrow="ALWAYS" />
        <!-- Close button (X) -->
        <Button fx:id="closeMenuBtn" text="×" onAction="#closeMenu"
                style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;" />
    </HBox>

    <!-- Container for all menu navigation buttons -->
    <VBox fx:id="menuItemsContainer" spacing="8">
        <!-- Navigation buttons - each calls a method in the controller -->
        <Button fx:id="dashboardBtn" text="Dashboard" onAction="#navigateToDashboard"
                styleClass="menu-item-btn" />
        <Button fx:id="profileBtn" text="Profile" onAction="#navigateToProfile"
                styleClass="menu-item-btn" />
        <Button fx:id="goalsBtn" text="Goals" onAction="#navigateToGoals"
                styleClass="menu-item-btn" />
        <Button fx:id="progressBtn" text="Progress" onAction="#navigateToProgress"
                styleClass="menu-item-btn" />
        <Button fx:id="settingsBtn" text="Settings" onAction="#navigateToSettings"
                styleClass="menu-item-btn" />

        <!-- Visual separator line -->
        <Separator style="-fx-background-color: #34495e;" />

        <!-- Logout button with different styling -->
        <Button fx:id="logoutBtn" text="Logout" onAction="#handleLogout"
                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12; -fx-font-size: 14; -fx-background-radius: 8;" />
    </VBox>

</VBox>
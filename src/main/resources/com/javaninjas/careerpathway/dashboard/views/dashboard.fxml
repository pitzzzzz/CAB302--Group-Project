<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" prefWidth="360.0" prefHeight="780.0" stylesheets="@../../app/app.css">
	<!-- Mobile-like dashboard layout: header, logo area, pathway card, bottom nav -->

	<!-- Header with back button include -->
	<fx:include source="../../core/views/topNavBack.fxml" />
	<HBox spacing="10" alignment="CENTER_LEFT" AnchorPane.topAnchor="10.0" AnchorPane.leftAnchor="48.0" AnchorPane.rightAnchor="10.0">
		<Label text="☰" style="-fx-font-size:20px; -fx-text-fill:#333; -fx-padding:6 8 6 8;" />
		<Label text="DASHBOARD" style="-fx-font-size:18px; -fx-font-weight:bold; -fx-text-fill:#333;" />
	</HBox>

	<!-- Main content column -->
	<VBox spacing="16" alignment="TOP_CENTER" AnchorPane.topAnchor="60.0" AnchorPane.leftAnchor="12.0" AnchorPane.rightAnchor="12.0">

		<!-- Logo / hero area -->
		<StackPane prefHeight="260.0" prefWidth="320.0">
			<Region style="-fx-background-color:#e6e6e6; -fx-background-radius:18;" prefWidth="320" prefHeight="260" />
			<Label text="[Logo]" style="-fx-font-size:28px; -fx-font-weight:bold; -fx-text-fill:#333;" />
		</StackPane>

		<!-- Greeting -->
		<Label text="Hello, (Name)" style="-fx-font-size:16px; -fx-text-fill:#222; -fx-padding:4 0 0 8;" AnchorPane.leftAnchor="20.0" />

		<!-- Pathway card -->
		<VBox spacing="12" alignment="CENTER_LEFT">
			<VBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color:linear-gradient(#e8f2ff,#d7eaff); -fx-background-radius:18; -fx-padding:16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 6, 0.0, 0, 2);">
				<Label text="Your Pathway" style="-fx-font-size:18px; -fx-font-weight:bold; -fx-text-fill:#0b4f94;" />
				<Label text="Pathway Step 1:" style="-fx-font-size:14px; -fx-text-fill:#234b80;" />

				<Button text="Continue" fx:id="continueButton" style="-fx-background-color: linear-gradient(#1ea1ff, #007bff); -fx-text-fill: white; -fx-background-radius:22; -fx-padding:8 28 8 28; -fx-font-weight:bold;" />
			</VBox>
		</VBox>

	</VBox>

	<!-- Bottom navigation dots -->
	<HBox spacing="12" alignment="CENTER" AnchorPane.bottomAnchor="18.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
		<Region style="-fx-background-color:#e6e6e6; -fx-pref-width:48; -fx-pref-height:12; -fx-background-radius:8; -fx-opacity:0.95;" />
		<HBox spacing="10" alignment="CENTER" >
			<Region style="-fx-background-color:#dcdcdc; -fx-pref-width:20; -fx-pref-height:20; -fx-background-radius:10;" />
			<Region style="-fx-background-color:#dcdcdc; -fx-pref-width:20; -fx-pref-height:20; -fx-background-radius:10;" />
			<Region style="-fx-background-color:#dcdcdc; -fx-pref-width:20; -fx-pref-height:20; -fx-background-radius:10;" />
			<Region style="-fx-background-color:#77a9ff; -fx-pref-width:20; -fx-pref-height:20; -fx-background-radius:10;" />
		</HBox>
	</HBox>

</AnchorPane>


<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javaninjas.careerpathway.pages.dashboard.controllers.PathwayController">
	<!-- Top header -->
	<top>
		<AnchorPane style="-fx-padding:16;">
			<Label text="Your Pathway To Becoming a Nurse" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="8" alignment="CENTER">
				<font>
					<Font name="System Bold" size="24" />
				</font>
			</Label>
			<Button fx:id="logoutBtn" text="Logout" AnchorPane.rightAnchor="12" AnchorPane.topAnchor="8" style="-fx-background-radius:16; -fx-padding:6 12;" onAction="#handleLogout" />
		</AnchorPane>
	</top>

	<!-- Center content with two columns: weeks and ask sidebar -->
	<center>
			<HBox spacing="16" style="-fx-padding:16;">
			<!-- Left: weeks list -->
			<VBox spacing="12" HBox.hgrow="ALWAYS">
				<!-- Week card template -->
				<VBox spacing="8" style="-fx-border-color:#cfcfcf; -fx-border-radius:10; -fx-background-radius:10; -fx-padding:12; -fx-background-color:transparent;">
					<HBox alignment="CENTER_LEFT">
						<Label text="Week 1" style="-fx-font-weight:bold; -fx-font-size:18;" />
						<Region HBox.hgrow="ALWAYS" />
						<Button text="Complete Tasks" style="-fx-background-color:#6699cc; -fx-text-fill:white; -fx-background-radius:16; -fx-padding:6 18;" />
					</HBox>
					<Label text="some copy explaining the learning..." style="-fx-text-fill:#333;" />
					<Label text="(e.g. they naturally love people, so careers in health may suit them)" style="-fx-text-fill:#888; -fx-font-size:11;" />
				</VBox>

				<VBox spacing="8" style="-fx-border-color:#cfcfcf; -fx-border-radius:10; -fx-background-radius:10; -fx-padding:12; -fx-background-color:transparent;">
					<HBox alignment="CENTER_LEFT">
						<Label text="Week 2" style="-fx-font-weight:bold; -fx-font-size:18;" />
						<Region HBox.hgrow="ALWAYS" />
						<Button text="Complete Tasks" style="-fx-background-color:#6699cc; -fx-text-fill:white; -fx-background-radius:16; -fx-padding:6 18;" />
					</HBox>
					<Label text="some copy explaining the learning..." style="-fx-text-fill:#333;" />
					<Label text="(e.g. they naturally love people, so careers in health may suit them)" style="-fx-text-fill:#888; -fx-font-size:11;" />
				</VBox>

				<VBox spacing="8" style="-fx-border-color:#cfcfcf; -fx-border-radius:10; -fx-background-radius:10; -fx-padding:12; -fx-background-color:transparent;">
					<HBox alignment="CENTER_LEFT">
						<Label text="Week 3" style="-fx-font-weight:bold; -fx-font-size:18;" />
						<Region HBox.hgrow="ALWAYS" />
						<Button text="Complete Tasks" style="-fx-background-color:#6699cc; -fx-text-fill:white; -fx-background-radius:16; -fx-padding:6 18;" />
					</HBox>
					<Label text="some copy explaining the learning..." style="-fx-text-fill:#333;" />
					<Label text="(e.g. they naturally love people, so careers in health may suit them)" style="-fx-text-fill:#888; -fx-font-size:11;" />
				</VBox>
			</VBox>

			<!-- Right: Ask anything box -->
			<VBox prefWidth="260" spacing="8" style="-fx-border-color:#cfcfcf; -fx-border-radius:10; -fx-background-radius:10; -fx-padding:12;">
				<Label text="Ask anything..." style="-fx-font-size:16; -fx-font-weight:bold;" />
				<Region VBox.vgrow="ALWAYS" />
				<HBox spacing="8" alignment="CENTER_RIGHT">
					<Button text="..." style="-fx-background-radius:12; -fx-padding:6 10;" />
				</HBox>
				<TextField promptText="Type a question..." style="-fx-background-radius:12; -fx-padding:8;" />
			</VBox>
		</HBox>
	</center>

	<!-- Bottom navigation -->
	<bottom>
        <fx:include source="../../core/components/views/bottomNav.fxml" />
	</bottom>
</BorderPane>


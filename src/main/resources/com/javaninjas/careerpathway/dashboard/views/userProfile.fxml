<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javaninjas.careerpathway.dashboard.controllers.ProfileController">
	<top>
		<AnchorPane style="-fx-padding:12;">
			<Button text="&#x2190; back" AnchorPane.leftAnchor="12" AnchorPane.topAnchor="8" style="-fx-background-color:transparent; -fx-font-size:14;" />
			<Button text="Logout" AnchorPane.rightAnchor="12" AnchorPane.topAnchor="8" style="-fx-background-radius:16; -fx-padding:6 12;" />
		</AnchorPane>
	</top>

	<center>
	<VBox spacing="20" style="-fx-padding:24;">
			<Label text="Your Details" style="-fx-font-size:28; -fx-font-weight:bold;" />

			<VBox spacing="10" maxWidth="420">
				<TextField promptText="First Name" style="-fx-background-radius:16; -fx-padding:8;" />
				<TextField promptText="Last Name" style="-fx-background-radius:16; -fx-padding:8;" />
				<TextField promptText="Email Address" style="-fx-background-radius:16; -fx-padding:8;" />
				<TextField promptText="Phone Number" style="-fx-background-radius:16; -fx-padding:8;" />
			</VBox>

			<Region VBox.vgrow="ALWAYS" />

			<HBox alignment="CENTER" style="-fx-padding:24;">
				<Button text="View Your Pathway Report" style="-fx-background-color:#6699cc; -fx-text-fill:white; -fx-background-radius:20; -fx-padding:12 28; -fx-font-size:16;" />
			</HBox>
		</VBox>
	</center>

	<bottom>
		<HBox alignment="CENTER" spacing="20" style="-fx-padding:12; -fx-border-color:#d0d0d0; -fx-border-width:1 0 0 0;">
			<Button fx:id="exploreBtn" text="Explore" HBox.hgrow="ALWAYS" styleClass="bottom-nav-button" />
			<Button fx:id="pathwayBtn" text="Your Pathway" HBox.hgrow="ALWAYS" styleClass="bottom-nav-button" />
			<Button fx:id="profileBtn" text="Profile" HBox.hgrow="ALWAYS" styleClass="bottom-nav-button" />
		</HBox>
	</bottom>
</BorderPane>

